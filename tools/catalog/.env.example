# Supply this environment variable to the collector only. Keep the real key out
# of iOS resources and tracked files. The collector does not auto-load .env files.
# Alternatively pass --service-key-file with a private file path.
DATA_GO_KR_SERVICE_KEY=

# Used only by enrich_coordinates.py with explicit --geocode. This key is never
# bundled in the app, written to evidence, or used for health/location history.
VWORLD_API_KEY=
